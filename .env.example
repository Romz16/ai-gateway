# Local demonstration only. Never commit .env or provider secrets.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://gateway:local@postgres:5432/gateway
REDIS_URL=redis://redis:6379/0
ENABLE_FAKE_PROVIDER=true
FAKE_PROVIDER_URL=http://fake-provider:8001
FAKE_PROVIDER_FAILURE_RATE=0
FAKE_PROVIDER_TIMEOUT_RATE=0
FAKE_PROVIDER_INVALID_OUTPUT_RATE=0
FAKE_PROVIDER_LATENCY_MS=10
CATALOG_PATH=config/models.json
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
MAX_RETRIES=2
CIRCUIT_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=20
PROVIDER_TIMEOUT_SECONDS=2
RETRY_BUDGET_PER_MINUTE=100
ENABLE_PROMPT_SECURITY=true
OTEL_ENDPOINT=http://jaeger:4318/v1/traces
