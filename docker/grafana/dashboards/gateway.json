        "x": 0,
        "y": 21,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(provider) (increase(gateway_estimated_cost_usd_total[1h]))",
          "legendFormat": "{{provider}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Retries / second",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(provider) (rate(gateway_retries_total[5m]))",
          "legendFormat": "{{provider}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Circuit openings",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
